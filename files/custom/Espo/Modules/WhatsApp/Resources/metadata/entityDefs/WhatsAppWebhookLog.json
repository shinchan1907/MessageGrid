{
  "fields": {
    "direction": {
      "type": "enum",
      "options": ["Incoming"],
      "default": "Incoming"
    },
    "payload": {
      "type": "text"
    },
    "statusCode": {
      "type": "int"
    },
    "status": {
      "type": "enum",
      "options": ["Success", "Error"],
      "default": "Success"
    },
    "errorMessage": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  }
}
